{
  "name": "@guidelens/desktop",
  "version": "1.0.0",
  "private": true,
  "author": {
    "name": "GuideLens Hackathon Team",
    "email": "guidelens@users.noreply.github.com"
  },
  "homepage": "https://k1lst1x.github.io/nvidia-dgx-spark-hackathon-2026/",
  "description": "GuideLens desktop camera and local YOLOX client",
  "main": "main.cjs",
  "scripts": {
    "sync-web": "node scripts/prepare.mjs",
    "start": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "45.2.2",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "edu.sfbu.guidelens.desktop",
    "productName": "GuideLens",
    "executableName": "GuideLens",
    "asar": true,
    "files": ["main.cjs", "web/**/*", "assets/**/*"],
    "directories": { "output": "release" },
    "mac": {
      "icon": "assets/icon.icns",
      "target": ["dmg", "zip"],
      "category": "public.app-category.healthcare-fitness",
      "extendInfo": {
        "NSCameraUsageDescription": "GuideLens uses the camera for private on-device object detection."
      }
    },
    "win": { "icon": "assets/icon.ico", "target": ["nsis", "zip"] },
    "linux": {
      "icon": "assets/icon.png",
      "target": ["AppImage", "deb", "tar.gz"],
      "category": "Utility",
      "maintainer": "GuideLens Hackathon Team <guidelens@users.noreply.github.com>"
    },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true },
    "artifactName": "GuideLens-${os}-${arch}.${ext}"
  }
}

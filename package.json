{
  "name": "guidelens",
  "version": "0.1.2",
  "private": true,
  "workspaces": [
    "apps/mobile",
    "apps/desktop"
  ],
  "scripts": {
    "dev": "npm --workspace apps/mobile run start",
    "web": "npm --workspace apps/mobile run web",
    "build:web": "npm --workspace apps/mobile run build:web",
    "typecheck": "npm --workspace apps/mobile run typecheck",
    "build:desktop": "npm run build:web && npm --workspace apps/desktop run sync-web"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}

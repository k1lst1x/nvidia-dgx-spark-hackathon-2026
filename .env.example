EXPO_PUBLIC_API_URL=http://localhost:8000
GROQ_API_KEY=replace_with_a_rotated_key
GROQ_VISION_MODEL=qwen/qwen3.8-27b
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://localhost:8082,http://127.0.0.1:8082
MAX_IMAGE_BYTES=1500000
MAX_CONCURRENCY=4
MIN_REQUEST_INTERVAL=1.5
# Optional server-side Ultralytics detector for Scene Assist. Review the
# Ultralytics AGPL-3.0 / Enterprise terms before enabling it in a distributed app.
ULTRALYTICS_YOLO_ENABLED=false
ULTRALYTICS_YOLO_MODEL=yolo11n.pt
ULTRALYTICS_YOLO_DEVICE=cpu
# Reset the single server-side ByteTrack feed after this many idle seconds.
YOLO_TRACK_IDLE_SECONDS=4
# `metric` reports approximate meters with the official metric Small/Indoor
# checkpoint. `relative` supports the pretrained ViT-L checkpoint but reports
# only nearer/farther scores within the current frame.
DEPTH_ANYTHING_ENABLED=false
DEPTH_ANYTHING_MODE=metric
DEPTH_ANYTHING_DEVICE=cuda
# For relative ViT-L, use:
# DEPTH_ANYTHING_MODE=relative
# DEPTH_ANYTHING_CHECKPOINT=/models/depth_anything_v2_vitl.pth

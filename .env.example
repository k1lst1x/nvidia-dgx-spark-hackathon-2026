EXPO_PUBLIC_API_URL=http://localhost:8000
# Opt-in developer overlay: track ID, direction, metric depth (when available),
# camera-relative trend, and measurement confidence.
EXPO_PUBLIC_VISION_DEBUG=false
# DGX Spark (OpenAI-compatible vLLM/NIM/Ollama). Leave VISION_API_URL unset to use Groq.
# VISION_API_URL=http://dgx-spark.local:8000/v1/chat/completions
# VISION_MODEL=Qwen/Qwen3-VL-32B-Instruct
# VISION_DISABLE_THINKING=true
# With VISION_API_URL pointing at the Spark, Groq (GROQ_API_KEY below) is used
# only when the Spark times out, errors or returns unreadable output.
# VISION_FALLBACK_TO_GROQ=true
# SPARK_VISION_TIMEOUT_S=10
GROQ_API_KEY=replace_with_a_rotated_key
GROQ_VISION_MODEL=qwen/qwen3.8-27b
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://localhost:8082,http://127.0.0.1:8082
# Optional deployment-wide Shared Sight gate. Every client also generates a
# separate high-entropy device secret that the API binds to its stable ID.
# Configure this shared key before upgrading an existing SQLite database so
# legacy device IDs can securely enroll their new per-device credential.
SHARED_SIGHT_TOKEN=
SHARED_SIGHT_DEVICE_IDS=
CAMPUS_ALERT_TTL_HOURS=12
OBSERVATION_MIN_CONFIDENCE=0.65
OBSERVATION_VERIFIED_SHARED_MIN_CONFIDENCE=0.40
MAX_IMAGE_BYTES=1500000
MAX_CONCURRENCY=4
MIN_REQUEST_INTERVAL=1.5
# Contextual-sign responses below this confidence remain hidden. Lowering it
# gives faster tentative phrases but does not make unsupported translations safe.
SIGN_MIN_CONFIDENCE=0.45
# Width in pixels of each signer crop sent to the vision model (three per request).
SIGN_FRAME_WIDTH=320
# Optional server-side Ultralytics detector for Scene Assist. Review the
# Ultralytics AGPL-3.0 / Enterprise terms before enabling it in a distributed app.
ULTRALYTICS_YOLO_ENABLED=false
# A "-seg" model tracks and segments in one pass (no second model per frame).
# On CPU the smaller ULTRALYTICS_YOLO_CPU_MODEL is used if set.
ULTRALYTICS_YOLO_MODEL=yolo11m-seg.pt
ULTRALYTICS_YOLO_CPU_MODEL=yolo11n-seg.pt
# Compute device per model (docs/DEVICES.md): auto, cpu, mps, cuda:0, cuda:1...
# auto = CUDA, then Apple MPS, then CPU, as far as the installed PyTorch can
# use them. A device that fails its warm-up falls back to CPU. Split models
# across devices if they do not fit on one GPU together.
YOLO_DEVICE=auto
SEG_DEVICE=auto
DEPTH_DEVICE=auto
SIGN_DEVICE=auto
# FP16 on CUDA only. Off by default; measured identical boxes on yolo11m-seg.
YOLO_HALF=false
SEG_HALF=false
DEPTH_HALF=false
# Optional YOLO11n-seg masks. The box tracker stays the source of identity.
ULTRALYTICS_YOLO_SEG_ENABLED=false
ULTRALYTICS_YOLO_SEG_MODEL=yolo11n-seg.pt
# Per-object center and extent from a metric depth map. Estimates, not a scan.
POINT_CLOUD_ENABLED=false
POINT_CLOUD_INTERVAL_S=0.5
# Sparse dots for unlabeled surfaces (walls, trees, poles) from metric depth.
# Only surfaces within OBSTACLE_MAX_RANGE_M are sent; the live map forgets them
# after a few seconds. Needs DEPTH_ANYTHING_MODE=metric.
OBSTACLE_POINTS_ENABLED=true
OBSTACLE_MAX_RANGE_M=4.5
OBSTACLE_MAX_POINTS=192
# Deaf-Blind bridge conversations are forgotten after this long without a message.
BRIDGE_TTL_HOURS=12
# Separate ORB-SLAM3 process. Off by default; detection continues if it is down.
# Monocular poses have no metric scale unless that process says so.
ORB_SLAM3_ENABLED=false
ORB_SLAM3_ENDPOINT=http://127.0.0.1:8099/pose
# Optional Rerun viewer. It does not change detection.
RERUN_ENABLED=false
RERUN_SPAWN=false
# Optional pinhole calibration. Without these, a 60-degree webcam stand-in is used.
# CAMERA_FX=
# CAMERA_FY=
# CAMERA_CX=
# CAMERA_CY=
# Reset the single server-side BoT-SORT/CMC feed after this many idle seconds.
YOLO_TRACK_IDLE_SECONDS=4
# Optional custom BoT-SORT config. The bundled config enables sparse optical
# flow camera-motion compensation for ID association; it is not 3-D ego motion.
# YOLO_TRACKER_CONFIG=/app/botsort.yaml
# `metric` reports approximate meters with the official metric Small/Indoor
# checkpoint. `relative` supports the pretrained ViT-L checkpoint but reports
# only nearer/farther scores within the current frame.
DEPTH_ANYTHING_ENABLED=false
DEPTH_ANYTHING_MODE=metric
# auto = 518 on a GPU, 364 on CPU (518 takes seconds per frame there).
DEPTH_ANYTHING_INPUT_SIZE=auto
# Experimental camera-relative trend analysis requires a metric checkpoint and
# repeated YOLO track IDs. It does not issue collision or mobility alerts.
MOBILITY_COLLISION_WARNINGS_ENABLED=false
# For relative ViT-L, use:
# DEPTH_ANYTHING_MODE=relative
# DEPTH_ANYTHING_CHECKPOINT=/models/depth_anything_v2_vitl.pth
# Optional research-only Uni-Sign How2Sign pose-only backend. Uni-Sign's
# checkpoint is CC-BY-NC-4.0 and must be downloaded separately; it expects
# RTM WholeBody 133-point coordinates plus confidence scores, not the 281
# VisionMate CTC vector. Keep false until the official sample passes locally.
UNISIGN_ENABLED=false
UNISIGN_REPO=/opt/uni-sign
UNISIGN_CHECKPOINT=/models/how2sign_pose_only_slt.pth
UNISIGN_MT5_PATH=/models/mt5-base
# Never turn this on for production without evaluation: it uses a presence
# proxy because MediaPipe Tasks does not expose RTM WholeBody confidences.
UNISIGN_ALLOW_MEDIAPIPE_PRESENCE_PROXY=false
